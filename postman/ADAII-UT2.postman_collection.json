                "persona.postman@adaii.local"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Persona Actualizada\",\n  \"apellido\": \"Postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "DELETE /personas/{email}",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/personas/persona.postman@adaii.local",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "personas",
                "persona.postman@adaii.local"
              ]
            }
          }
        }
      ]
