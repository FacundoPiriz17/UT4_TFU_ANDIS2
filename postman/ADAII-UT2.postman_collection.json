{
  "info": {
    "_postman_id": "adaii-ut2-architecture-demo",
    "name": "ADAII UT2 - Rollback, Polimorfismo y Aspectos",
    "description": "Coleccion para probar la API REST y demostrar las tacticas de arquitectura. Ejecutar Login primero para guardar automaticamente el JWT. token y juegoId se guardan en variables de coleccion; el entorno solo configura la URL y las credenciales. Ejecutar POST /juegos antes de actualizar o eliminar el juego creado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "demoEmail",
      "value": "demo@adaii.local"
    },
    {
      "key": "demoPassword",
      "value": "Demo123!"
    },
    {
      "key": "juegoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Estado",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            }
          }
        },
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "GET /version",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/version",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "version"
              ]
            }
          }
        },
        {
          "name": "GET /instance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instance",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "instance"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Instancia disponible', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test('Identidad coherente con X-Instance-ID', function () {",
                  "  pm.expect(data.instance).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.instance).to.eql(pm.response.headers.get('X-Instance-ID'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"contrasena\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Personas",
      "item": [
