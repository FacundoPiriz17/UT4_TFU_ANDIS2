    {
      "name": "Cache-aside - Demo",
      "description": "Ejecutar en orden (Run folder). Muestra MISS -> HIT -> invalidacion al escribir -> MISS. El header X-Instance-ID muestra que el HIT puede venir de otra replica: el cache esta en Redis y es compartido por api1 y api2.",
      "item": [
        {
          "name": "1. GET /juegos - carga el cache",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/juegos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "juegos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catalogo disponible', function () { pm.response.to.have.status(200); });",
                  "pm.test('Header X-Cache presente', function () { pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT', 'MISS']); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. GET /juegos - HIT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/juegos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "juegos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catalogo disponible', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta servida desde Redis', function () { pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. POST /juegos - invalida el catalogo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/juegos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "juegos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juego demo cache\",\n  \"generos\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Juego creado', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('cacheJuegoId', pm.response.json().id_juego);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. GET /juegos - MISS tras invalidar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/juegos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "juegos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catalogo disponible', function () { pm.response.to.have.status(200); });",
                  "pm.test('Cache invalidado por la escritura', function () { pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'); });",
                  "pm.test('Incluye el juego nuevo', function () {",
                  "  const id = Number(pm.collectionVariables.get('cacheJuegoId'));",
                  "  pm.expect(pm.response.json().map(j => j.id_juego)).to.include(id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. GET /juegos - HIT de nuevo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/juegos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "juegos"
              ]
            }
          },
          "event": [
